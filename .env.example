# Copy this file to .env and fill in your values.
# NEVER paste the bot token into any chat.

TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Deriv symbol for Crash 1000 (leave as is)
SYMBOL=R_1000

# Deriv app_id — 1089 is Deriv's public demo app and works as is.
# Your own free app_id (api.deriv.com -> Register application) gives
# you private rate limits; paste it here if you register one.
DERIV_APP_ID=1089

# A tick counts as a spike when it jumps up by more than this fraction
# (0.005 = 0.5%). Tune after watching a few real spikes.
SPIKE_PCT=0.005

# Minimum seconds between two alerts (safety net)
ALERT_COOLDOWN_SEC=300

# How many recent ticks to keep for your rule
TICK_BUFFER=5000

# --- Market-structure engine (trend / AMD phase / sweeps) ---
# Candles are built from ticks; structure refreshes on each candle close.
CANDLE_MINUTES=1
CANDLE_KEEP=1000
# Historical candles fetched at startup (the CRT engine needs ~252
# bars of warmup; this gives it instantly instead of waiting hours)
HISTORY_CANDLES=1000
# Fractal swing sensitivity (bars each side)
SWING_LEFT=3
SWING_RIGHT=3
TREND_LOOKBACK=120
# Sweep detection: reference = high/low of last SWEEP_LOOKBACK candles,
# excluding the newest SWEEP_EXCLUDE; scan the newest SWEEP_SCAN.
SWEEP_LOOKBACK=20
SWEEP_EXCLUDE=5
SWEEP_SCAN=5
# Accumulation = range of last ACCUM_BARS candles <= ACCUM_ATR_MULT * ATR
ACCUM_BARS=60
ACCUM_ATR_MULT=2.5
# A sweep counts as "manipulation" for MANIP_BARS candles after it ...
MANIP_BARS=10
# ... and as "distribution" for DIST_BARS candles after the BOS that follows
DIST_BARS=15

# --- Volumatic VIDYA trend engine (reconstruction of the public spec) ---
# VIDYA core smoothing (Chande CMO period)
VIDYA_PERIOD=9
# ATR band: period and distance multiplier around the VIDYA line.
# Smaller VOL_ATR_MULT = earlier (noisier) trend flips.
VOL_ATR_PERIOD=14
VOL_ATR_MULT=2.0

# --- CRT Pre-Reversal Engine (your strategy — CRT_PreReversal_Engine.mq5) ---
# Defaults below are exactly the MQL input defaults. Change only if you
# run different inputs on your MT5 chart.
CRT_ASSET_MODE=crash
CRT_MIN_SCORE=4
CRT_RANGE_BARS=3
CRT_MIN_CONSECUTIVE=3
CRT_RSI_PERIOD=14
CRT_RSI_LEVEL=30
CRT_STRETCH_EMA=20
CRT_STRETCH_ATR=1.5
CRT_DROP_LOOKBACK=30
CRT_DROP_ATR=6.0
CRT_SPIKE_ATR_MULT=3.0
CRT_MIN_DRIFT_BARS=2
CRT_MAX_SIGNALS_PER_CYCLE=1
CRT_COOLDOWN_BARS=4
CRT_SPIKE_SCAN_DEPTH=200
CRT_SL_ATR_MULT=5.0
CRT_TP_MODE=avg_spike
CRT_TP_SPIKE_FRAC=0.8
CRT_RR=2.0
